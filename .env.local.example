# Doppler is the source of truth for env vars (configs: dev / stg / prd).
# This file documents the variable NAMES only — never paste real values here.
# Copy to .env.local for a quick local fallback, or (preferred) run via:
#   doppler run -- npm run dev

# --- Supabase (client-exposed: inlined into the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only: never reaches the client bundle) ---
NEXT_SUPABASE_SERVICE_ROLE_KEY=

# --- Spotify OAuth app (https://developer.spotify.com/dashboard) ---
# Client id may be public; the secret is server-only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
